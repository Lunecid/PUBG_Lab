    "fidelity_code": RES / "fidelity" / "krafton_fidelity.py",  # its metric code: loaded read-only for the one arm the CSV does not have
}
MAIN_SEED, STRATUM, N_BOOT = 42, "all", 2000
CM = 1 / 2.54  # inch per cm
MIN_PT = 7.0  # nothing smaller than this at final size
PANEL_LETTER_PT = 8.0
