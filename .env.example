# PostgreSQL 접속 정보 / PostgreSQL connection settings
# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 .gitignore에 포함되어 커밋되지 않습니다.
# Copy this file to .env and fill in real values. .env is gitignored and must never be committed.
PUBG_DB_HOST=localhost
PUBG_DB_PORT=5432
PUBG_DB_NAME=pubg_survival
PUBG_DB_USER=postgres
PUBG_DB_PASSWORD=change-me
